rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super Admin Roles & Permissions (see lib/roles.js):
    //  - superadmin: hardcoded email list below (keep in sync with
    //    ADMIN_EMAILS in lib/config.js) — can never be locked out, and is
    //    the only one allowed to grant/revoke the roles below.
    //  - admin: granted via users/{uid}.role == "admin" by a superadmin —
    //    same powers as before (recharge approval, force-end rooms, analytics).
    //  - moderator: users/{uid}.role == "moderator" — reports triage only.
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["abdulhadi7888888@gmail.com"];
    }

    function isAdmin() {
      return isSuperAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    function isModerator() {
      return isAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "moderator");
    }

    // Users can read any profile, but only edit their own (or an admin, for recharge approval).
    // Exception: followersCount/followingCount are counters that the OTHER
    // side of a follow/unfollow needs to bump on your doc (see lib/follow.js).
    // Same MVP caveat as coins/diamonds elsewhere in this file — a fully
    // locked-down version would move counter writes into a Cloud Function.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        // Only a superadmin may ever change someone's `role` field.
        isSuperAdmin() ||
        (
          !("role" in request.resource.data.diff(resource.data).affectedKeys()) && (
            request.auth.uid == userId ||
            isAdmin() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["followersCount"]) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["followingCount"])
          )
        )
      );
      allow delete: if false;
    }

    // Agencies — a leader manages an agency; hosts join by entering its
    // code (which sets their own users/{uid}.agencyId, already allowed
    // above since users can edit their own doc).
    match /agencies/{agencyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leaderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.leaderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount"])
      );
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;
    }

    // Daily check-in / Lucky Box / Spin Wheel state — owner-only.
    match /rewardStatus/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Best-effort win logs for Lucky Box / Spin Wheel (lib/rewards.js) —
    // write-once by the player, admin can read for auditing.
    match /luckyBoxLog/{entryId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /spinWheelLog/{entryId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Follow / Following edges — id is "{followerId}_{followingId}"
    match /follows/{edgeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // CP requests — either side of the request can read it; only the
    // sender can create, only the recipient can accept/decline (update).
    match /cpRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // CP pairs — id is "{uid1}_{uid2}" (sorted). Either partner can read;
    // creation happens via acceptCpRequest (recipient accepting) and
    // either partner can delete (break up).
    match /cpPairs/{pairId} {
      allow read: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Friend requests — same pattern as CP requests
    match /friendRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // Friendships — id is "{uid1}_{uid2}" (sorted). Either friend can read
    // or remove; created by the recipient accepting a friend request.
    match /friendships/{pairId} {
      allow read: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Blocks — id is "{blockerId}_{blockedId}"; only the blocker can see/manage their own list
    match /blocks/{edgeId} {
      allow read: if request.auth != null && (resource.data.blockerId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.blockerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // Reports — anyone can file one about themselves as reporter; only admins can read/triage
    match /reports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if isModerator();
      allow update: if isModerator();
      allow delete: if false;
    }

    // Notifications — owner-only inbox. Any signed-in user can create a
    // notification for someone else (e.g. a follow event), but only as new/unread.
    match /notifications/{uid}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.resource.data.read == false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    // Live streams & audio rooms
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      // Host can update anything (end room, PK battle score, etc). Anyone
      // signed in can update seats only — needed so guests can claim/leave
      // a seat in audio rooms.
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seats"]) ||
        // Co-host invite accept/decline, or the current co-host leaving —
        // only the person becoming/leaving co-host may touch these keys.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["coHostUid", "coHostName", "coHostInvite"]) &&
          (
            !("coHostUid" in request.resource.data) ||
            request.resource.data.coHostUid == request.auth.uid ||
            resource.data.coHostUid == request.auth.uid
          )
        )
      );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Chat messages inside a room
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Gift feed inside a room
      match /gifts/{giftId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Vehicle entrance announcements ("rides in on...") — short-lived feed
      match /entrances/{entranceId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Who's currently in the room (self-managed heartbeat) — lets the
      // host see people to invite as a video co-host (lib/coHost.js).
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Recharge requests — user submits; only an admin (or ideally a Cloud
    // Function) should approve/reject.
    match /rechargeRequests/{reqId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Diamond withdraw (cashout) requests — host submits (diamonds already
    // deducted client-side in the same transaction, see lib/wallet.js);
    // only an admin can approve (mark paid) or reject (refunds diamonds).
    match /withdrawRequests/{reqId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Families — leader manages settings; any signed-in member can update
    // only the members list (join/leave) or totalDiamonds (contribute)
    match /families/{familyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leaderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.leaderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "totalDiamonds", "level"])
      );
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;
    }
  }
}
