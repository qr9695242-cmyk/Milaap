// Ludo entry is paid in Coins. Match winnings are credited as Diamonds at 2.5 Coins = 1 Diamond.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super Admin Roles & Permissions (see lib/roles.js):
    //  - superadmin: hardcoded email list below (keep in sync with
    //    ADMIN_EMAILS in lib/config.js) — can never be locked out, and is
    //    the only one allowed to grant/revoke the roles below.
    //  - admin: granted via users/{uid}.role == "admin" by a superadmin —
    //    same powers as before (recharge approval, force-end rooms, analytics).
    //  - moderator: users/{uid}.role == "moderator" — reports triage only.
    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["abdulhadi7888888@gmail.com"];
    }

    function isAdmin() {
      return isSuperAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    function isModerator() {
      return isAdmin() || (request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "moderator");
    }

    // Users can read any profile, but only edit their own (or an admin, for recharge approval).
    // Exception: followersCount/followingCount are counters that the OTHER
    // side of a follow/unfollow needs to bump on your doc (see lib/follow.js).
    // `diamonds` is the same kind of exception — whoever SENDS you a gift
    // needs to credit your diamonds in the same transaction that deducts
    // their own coins (see lib/gifts.js sendGift). Same MVP caveat as
    // elsewhere in this file — a fully locked-down version would move
    // counter writes into a Cloud Function.
    // PK Battles between two live-streaming hosts (lib/pkbattle.js,
    // components/PkBattlePanel.jsx). Any signed-in user can read (so both
    // sides' viewers see the score bar) and challenge a room they don't
    // host is blocked client-side by the picker; server-side we just make
    // sure whoever writes only ever touches score/status fields — that's
    // what lets any viewer's gift bump the score via addBattleScore().
    match /pkBattles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostAId == request.auth.uid;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["scoreA", "scoreB", "status"]);
      allow delete: if false;
    }

    match /decorationMedia/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Occasion / event banners (e.g. "Eid Mubarak" strip with a picture +
    // optional coin reward) — see lib/eventBanners.js, managed from the
    // "Occasion Banners" card in /admin. Public read so everyone's banner
    // strip can show them, admin-only create/update/delete. The per-user
    // claim record under each banner can only be written by that user
    // (once — claimEventBanner's transaction checks it doesn't exist yet)
    // or read by an admin.
    match /eventBanners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /claims/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }

    // Referral / "Invite Friends" program config — public read so /invite
    // can show the current reward + whether the offer is live, admin-only
    // write (see lib/referral.js setReferralConfig, used from /admin).
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One doc per referral code, used only to reserve codes so two users
    // can never collide (lib/referral.js ensureReferralCode). A user may
    // only ever reserve a code for themselves, and codes are permanent.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Audit trail of paid-out referral bonuses — written only by the
    // awardReferralBonus Cloud Function (Admin SDK bypasses these rules),
    // never directly by clients.
    match /referrals/{newUserId} {
      allow read: if request.auth != null &&
        (request.auth.uid == newUserId || isAdmin());
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        // Only a superadmin may ever change someone's `role` field.
        isSuperAdmin() ||
        (
          !("role" in request.resource.data.diff(resource.data).affectedKeys()) && (
            request.auth.uid == userId ||
            isAdmin() ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["followersCount"]) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["followingCount"]) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["diamonds"])
          )
        )
      );
      allow delete: if false;
    }

    // Profile visitors — owner-only read (who visited me); any signed-in
    // user may write only their OWN entry under someone else's list (i.e.
    // "I visited them"), never anyone else's. Powers the SVIP "Hide
    // visitor records" toggle + "View visitor records" privilege.
    match /users/{userId}/visitors/{visitorUid} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == visitorUid;
    }
    // Agencies — a leader manages an agency; hosts join by entering its
    // code (which sets their own users/{uid}.agencyId, already allowed
    // above since users can edit their own doc).
    match /agencies/{agencyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leaderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.leaderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount"])
      );
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;
    }

    // Daily check-in / Lucky Box / Spin Wheel state — owner-only.
    match /rewardStatus/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Daily Reward 7-day sign-in popup state (lib/dailyReward.js) — same
    // owner-only shape as rewardStatus above, just a separate doc so the
    // two streaks (Check-in tab vs. this auto-popup) never collide.
    match /dailyRewardStatus/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Room Entry Reward 7-day streak (lib/roomEntryReward.js) — same
    // owner-only shape, claimed by entering a room instead of opening the app.
    match /roomEntryRewardStatus/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Best-effort win logs for Lucky Box / Spin Wheel (lib/rewards.js) —
    // write-once by the player, admin can read for auditing.
    match /luckyBoxLog/{entryId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /spinWheelLog/{entryId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Follow / Following edges — id is "{followerId}_{followingId}"
    match /follows/{edgeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.followerId == request.auth.uid || resource.data.followingId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // CP requests — either side of the request can read it; only the
    // sender can create, only the recipient can accept/decline (update).
    match /cpRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // CP pairs — id is "{uid1}_{uid2}" (sorted). Either partner can read;
    // creation happens via acceptCpRequest (recipient accepting) and
    // either partner can delete (break up).
    match /cpPairs/{pairId} {
      allow read: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Friend requests — same pattern as CP requests
    match /friendRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // Friendships — id is "{uid1}_{uid2}" (sorted). Either friend can read
    // or remove; created by the recipient accepting a friend request.
    match /friendships/{pairId} {
      allow read: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Blocks — id is "{blockerId}_{blockedId}"; only the blocker can see/manage their own list
    match /blocks/{edgeId} {
      allow read: if request.auth != null && (resource.data.blockerId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.blockerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // Reports — anyone can file one about themselves as reporter; only admins can read/triage
    match /reports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if isModerator();
      allow update: if isModerator();
      allow delete: if false;
    }

    // Notifications — owner-only inbox. Any signed-in user can create a
    // notification for someone else (e.g. a follow event), but only as new/unread.
    match /notifications/{uid}/items/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.resource.data.read == false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    // Live streams & audio rooms
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      // Host can update anything (end room, PK battle score, etc). Anyone
      // signed in can update seats only — needed so guests can claim/leave
      // a seat in audio rooms.
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seats"])
      );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // Chat messages inside a room
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Gift feed inside a room
      match /gifts/{giftId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Vehicle entrance announcements ("rides in on...") — short-lived feed
      match /entrances/{entranceId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }

      // Who's currently in the room (self-managed heartbeat) — lets the
      // host see people to bring onto a seat (lib/coHost.js).
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // "Request Seat" taps on a locked seat (lib/roomRequests.js →
      // components/SeatActionSheet.jsx "Request Seat" + components/
      // RoomRequests.jsx on the host's screen). Only the requester and
      // the person it's addressed to (normally the host) can read a
      // given request; only the requester can create it; only the
      // addressee (or the host, if seats got reshuffled) can resolve it.
      match /seatRequests/{requestId} {
        allow read: if request.auth != null &&
          (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid || isAdmin());
        allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
        allow update: if request.auth != null &&
          (request.auth.uid == resource.data.toUid || isAdmin());
        allow delete: if false;
      }
    }

    // Recharge requests — user submits; only an admin (or ideally a Cloud
    // Function) should approve/reject.
    match /rechargeRequests/{reqId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.reference is string
        && request.resource.data.reference.size() > 0;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && (request.resource.data.status != "approved" || (resource.data.reference is string && resource.data.reference.size() > 0));
      allow delete: if false;
    }

    // Virtual game economy: each player may create/read only their own game sessions/history.
    // Coin balance changes still use the existing users/{uid} rule and are never
    // exposed as a second wallet. Sessions are idempotently settled by the app.
    match /gameSessions/{sessionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /users/{uid}/gameHistory/{historyId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.sessionId is string;
      allow update, delete: if false;
    }

    // Families — leader manages settings; any signed-in member can update
    // only the members list (join/leave) or totalDiamonds (contribute)
    match /families/{familyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leaderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.leaderId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "totalDiamonds", "level"])
      );
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;
    }

    // Ludo matches: real-time 2- or 4-player matches. Entry is in Coins; winner payout is Diamonds.
    // Ludo matches are server-authoritative. Clients can only read live state.
    // Create/join/roll/move/settlement/refunds are performed by trusted Cloud Functions.
    match /ludoMatches/{matchId} {
      allow read: if request.auth != null && (resource.data.status == "waiting" || request.auth.uid in resource.data.playerUids);
      allow create, update, delete: if false;
    }

    match /ludoMatchHistory/{historyId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.playerUids;
      allow update, delete: if false;
    }

    // One doc per casual game type (id = gameId, e.g. "chess", "carrom")
    // pointing at whichever casualMatches doc is currently "waiting" for
    // an opponent, if any. quickMatchCasual (lib/casualMatches.js) reads
    // + writes this doc in the SAME transaction as the match doc itself,
    // so two players matchmaking at once can't both open their own
    // waiting match and never find each other. Any signed-in user may
    // update it (it holds no money, just a pointer), but never delete it.
    match /casualLobby/{gameId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.data.keys().hasOnly(["waitingMatchId", "waitingHostUid"]) &&
        (resource == null || resource.data.keys().hasOnly(["waitingMatchId", "waitingHostUid"]));
      allow delete: if false;
    }

    // Casual (free, no coin stake) games — Chess, Archery, etc. No
    // money on the line, so unlike Ludo/Snake&Ladder these are trusted
    // to write their own match state directly (lib/casualMatches.js).
    match /casualMatches/{matchId} {
      allow read: if request.auth != null && (resource.data.status == "waiting" || request.auth.uid in resource.data.playerUids);
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid && request.resource.data.status == "waiting";
      // Two cases: (a) a player already in the match updating live state
      // (moves, settlement flags, etc), or (b) a NEW player joining a
      // still-"waiting" match — at write time they're not in the OLD
      // playerUids yet (that's the whole point of joining), so we check
      // that they ARE in the resulting playerUids instead. Without (b),
      // the second player to tap "Start Coin Match" always got rejected
      // here since resource.data.playerUids only ever had the host.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.playerUids ||
        (resource.data.status == "waiting" && request.auth.uid in request.resource.data.playerUids)
      );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }


    // Production cash-out records. Clients can only read their own history.
    // Creation/approval/rejection is server-only through callable Functions.
    match /withdrawalRequests/{requestId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Immutable financial audit ledger. Admin/server only.
    match /walletLedger/{entryId} {
      allow read: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

  }
}
