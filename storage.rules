rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Frame / vehicle decoration media (photos or videos) — anyone signed in
    // can upload a replacement image/video for a catalog item from the shop
    // page's upload icon. Publicly readable so it renders for every visitor.
    match /decorations/{type}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (type == "frame" || type == "vehicle")
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches("image/.*") || request.resource.contentType.matches("video/.*"));
    }

    // Profile avatars now upload directly to Cloudinary (see lib/cloudinary.js)
    // instead of Firebase Storage, same as frame/vehicle decorations above.

    // Everything else stays locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
